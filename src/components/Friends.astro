---
interface Props {
  name: string;
  avatar?: string | null;
  description: string;
  url: string;
}

const {name, avatar = null, description, url} = Astro.props;
---

<a
  class="flex items-center gap-4 border border-neutral-200 bg-white p-4 rounded-sm shadow-sm transition-colors hover:border-neutral-400 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-600"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
>
  {avatar && (
    <img
      class="h-14 w-14 shrink-0 rounded-sm object-cover bg-neutral-100 dark:bg-neutral-800"
      src={avatar}
      alt={name}
    />
  )}
  <div class="flex min-w-0 flex-col justify-center gap-1">
    <div class="truncate font-bold text-neutral-900 dark:text-neutral-100" title={name}>
      {name}
    </div>
    <div class="truncate text-sm text-neutral-500 dark:text-neutral-400" title={description}>
      {description}
    </div>
  </div>
</a>
