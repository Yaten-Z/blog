---
import FeedPostDate from "./FeedPostDate.astro";
import getUrl from "@/utils/getUrl";
const {data, body, id} = Astro.props.post;
const {index} = Astro.props;

const title =
  body
    .split("\n")
    .map((line) =>
      line
        .replace(/^#+\s?/, "")
        .replace(/!?\[.*?\]\(.*?\)/g, "")
        .replace(/\\\s*$/, "")
        .trim()
    )
    .find((line) => line.length > 0) ?? "";
---

<div class="my-5 first:mt-0">
  <div class="text-skin-base">
    <a
      class="flex text-xl underline-offset-4 cursor-pointer decoration-skin-base decoration-wavy hover:underline font-bold break-all"
      href={getUrl("/feed/") + id}
    >
      {title}
    </a>

    <div class="flex flex-wrap items-center my-2 text-skin-dodge">
      <FeedPostDate date={data.date} index={index} />
    </div>
  </div>
</div>
<div class="divider-horizontal-mini"></div>
