---
import { render } from "astro:content";
import getUrl from "@/utils/getUrl";
import { formatDate } from "@/utils/formatDate";
import { t } from "@/i18n/utils";
const post = Astro.props.post;
const { data, id } = post;
const { Content } = await render(post);

const url = getUrl("/feed/") + id;
---

<div class="my-5 first:mt-0">
  <div class="text-skin-base">
    <div class="flex flex-wrap items-center my-2 text-skin-dodge">
      {
        data.date && (
          <div class="mr-2">
            <i class="ri-calendar-2-fill mr-1" />
            {formatDate(data.date)}
          </div>
        )
      }
    </div>
  </div>
  <article class="markdown-body scroll-smooth mb-4 break-all">
    <Content />
  </article>
  <a
    class="inline-flex items-center text-skin-active underline-offset-4 decoration-skin-active decoration-wavy hover:underline"
    href={url}
  >
    {t("feed.readMore")}
    <i class="ri-arrow-right-s-line ml-1" />
  </a>
</div>
<div class="divider-wavy"></div>
