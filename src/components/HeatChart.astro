---
import { getCollection } from 'astro:content'
import { dateKey, todayInBeijing } from '../utils/date'

const [posts, essays, feed] = await Promise.all([
  getCollection('posts'),
  getCollection('essays'),
  getCollection('feed'),
])
const counts = new Map<string, { posts: number; essays: number; feed: number }>()

const add = (date: Date, kind: 'posts' | 'essays' | 'feed') => {
  const key = dateKey(date)
  const entry = counts.get(key) ?? { posts: 0, essays: 0, feed: 0 }
  entry[kind] += 1
  counts.set(key, entry)
}

posts.forEach(post => add(post.data.published, 'posts'))
essays.forEach(entry => add(entry.data.published, 'essays'))
feed.filter(entry => !entry.data.draft).forEach(entry => add(entry.data.date, 'feed'))

const buildWeeks = (weeks: number) => {
  const end = todayInBeijing()
  const start = new Date(end)
  start.setUTCDate(end.getUTCDate() - end.getUTCDay() - (weeks - 1) * 7)

  return Array.from({ length: weeks }, (_, weekIndex) =>
    Array.from({ length: 7 }, (_, dayIndex) => {
      const date = new Date(start)
      date.setUTCDate(start.getUTCDate() + weekIndex * 7 + dayIndex)

      const key = date.toISOString().slice(0, 10)
      const entry = counts.get(key)
      const count = entry ? entry.posts + entry.essays + entry.feed : 0
      const level = count === 0 ? 0 : count === 1 ? 1 : count === 2 ? 2 : count <= 4 ? 3 : 4

      const parts = entry
        ? [
            entry.posts && `${entry.posts} 篇文章`,
            entry.essays && `${entry.essays} 篇随笔`,
            entry.feed && `${entry.feed} 条动态`,
          ].filter(Boolean)
        : []

      const dateLabel = key.replaceAll('-', '.')
      return {
        key,
        count,
        level,
        label: parts.length ? `${dateLabel} · ${parts.join(' · ')}` : `${dateLabel} · 暂无内容`,
      }
    }),
  )
}

const variants = [
  { className: 'heatmap-desktop', weeks: buildWeeks(53), label: '近一年写作热力图' },
  { className: 'heatmap-mobile', weeks: buildWeeks(26), label: '近半年写作热力图' },
]
---

{variants.map((variant) => (
  <div class={`heatmap ${variant.className}`}>
    <div class="heatmap-grid" role="img" aria-label={variant.label}>
      {variant.weeks.map((week) => (
        <div class="heatmap-week">
          {week.map((day) => (
            <span
              class={`heatmap-day level-${day.level}`}
              data-label={day.label}
              aria-label={day.label}
            />
          ))}
        </div>
      ))}
    </div>
    <div class="heatmap-tooltip" role="tooltip" hidden></div>
  </div>
))}

<script>
  const grids = document.querySelectorAll<HTMLElement>('.heatmap-grid')

  grids.forEach((grid) => {
    const tooltip = grid.parentElement?.querySelector<HTMLElement>('.heatmap-tooltip')
    if (!tooltip) return

    const show = (day: HTMLElement, event: PointerEvent) => {
      const map = grid.parentElement
      if (!map) return

      tooltip.textContent = day.dataset.label ?? ''
      tooltip.hidden = false

      const rect = map.getBoundingClientRect()
      const half = tooltip.offsetWidth / 2
      const x = Math.min(Math.max(event.clientX - rect.left, half), rect.width - half)
      const y = event.clientY - rect.top

      tooltip.style.left = `${x}px`
      tooltip.style.top = `${y}px`
    }

    const hide = () => {
      tooltip.hidden = true
    }

    grid.addEventListener('pointermove', (event) => {
      const target = event.target as HTMLElement
      const day = target.closest<HTMLElement>('.heatmap-day')
      if (!day) {
        hide()
        return
      }
      show(day, event)
    })

    grid.addEventListener('pointerleave', hide)
  })
</script>

<style>
  .heatmap {
    position: relative;
    width: 100%;
    user-select: none;
  }

  .heatmap-mobile {
    display: none;
  }

  .heatmap-grid {
    display: flex;
    width: 100%;
    gap: 2px;
  }

  .heatmap-week {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .heatmap-day {
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--bg-sunken);
  }

  .heatmap-day.level-1 {
    background-color: color-mix(in srgb, var(--accent-color) 30%, var(--bg-sunken));
  }

  .heatmap-day.level-2 {
    background-color: color-mix(in srgb, var(--accent-color) 50%, var(--bg-sunken));
  }

  .heatmap-day.level-3 {
    background-color: color-mix(in srgb, var(--accent-color) 70%, var(--bg-sunken));
  }

  .heatmap-day.level-4 {
    background-color: var(--accent-color);
  }

  .heatmap-tooltip {
    position: absolute;
    z-index: 10;
    padding: 4px 8px;
    background-color: var(--text-title-color);
    color: var(--bg-color);
    font-size: var(--text-description-fontsize);
    line-height: 1.6;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 8px));
    box-shadow: 0 4px 12px var(--shadow-color);
  }

  @media (max-width: 640px) {
    .heatmap-desktop {
      display: none;
    }

    .heatmap-mobile {
      display: block;
    }

    .heatmap-grid,
    .heatmap-week {
      gap: 1px;
    }
  }
</style>
