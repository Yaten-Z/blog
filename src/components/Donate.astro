---
import "@/styles/donate.css";
import {donate} from "@/consts";
---
<div class="mt-4">
  <div class="esa-sponsor">
    <div class="tip flex items-center justify-center my-4">
      {donate.tip}
    </div>
    <div class="flex items-center justify-center">
      <div id="wechatpay" class="border rounded p-2">
        <img src="/wechat.svg" class="h-4" alt="wechat"/>
      </div>
    </div>
    <div class="qrshow">
      <img src={donate.wechatQRCode} alt="wechatQRCode"/>
    </div>
  </div>
</div>

<script>
  import {donate} from "../consts";

  // ClientRouter swaps <body> on navigation, so #wechatpay is fresh on each
  // page. Re-bind the hover handler on astro:page-load.
  function bindDonate() {
    const qrDiv = document.getElementsByClassName("qrshow");
    const wechatDiv = document.getElementById("wechatpay");

    if (donate.wechatQRCode) {
      wechatDiv?.addEventListener("mouseenter", () => {
        qrDiv[0]?.style.setProperty("display", "block");
      });
      wechatDiv?.addEventListener("mouseleave", () => {
        qrDiv[0]?.style.setProperty("display", "none");
      });
    }
  }

  document.addEventListener("astro:page-load", bindDonate);
</script>
