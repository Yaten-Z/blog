---
import { COMMENT_CONFIG } from '../config';
import '../styles/waline.css';

interface Props {
  // 用于 giscus 的 specific 映射，默认使用当前页面路径
  term?: string;
}

const { term = Astro.url.pathname } = Astro.props;
const serverURL = COMMENT_CONFIG.waline.serverURL;
---

{COMMENT_CONFIG.enable && COMMENT_CONFIG.provider === 'waline' && (
  <>
    <section class="comment">
      <div id="waline" class="waline-container" data-server-url={serverURL}></div>
    </section>
    <script is:inline>
  // 把“实际生效的暗色状态”同步到 <html data-dark>，供 Waline 的 dark 选择器匹配。
  // 站点是混合模式：手动切换写 data-theme，auto 模式无 data-theme 时跟随系统偏好。
  function syncDark() {
    const el = document.documentElement;
    const attr = el.getAttribute('data-theme');
    const dark =
      attr === 'dark' ||
      (!attr && window.matchMedia('(prefers-color-scheme: dark)').matches);
    el.setAttribute('data-dark', dark ? 'true' : 'false');
  }
  syncDark();
  new MutationObserver(syncDark).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncDark);

  (async function () {
    const container = document.getElementById('waline');
    if (!container) return;
    const serverURL = container.getAttribute('data-server-url');
    if (!serverURL) {
      container.textContent = '评论系统配置错误';
      return;
    }
    try {
      const { init } = await import('https://unpkg.com/@waline/client@v3/dist/waline.js');
      init({
        el: '#waline',
        serverURL,
        lang: 'zh-CN',
        dark: 'html[data-dark="true"]',
        reaction: false,
        imageUploader: false,  // 禁用图片上传（同时隐藏工具栏上传按钮）
        noRss: true,           // 隐藏评论区 RSS 订阅链接
      });

      // 评论计数改为“评论 (n)”：locale 无此配置项，只能渲染后改写文本。
      // Waline 提交/加载评论会重渲染，用 MutationObserver 持续修正。
      function fixCount() {
        const el = container.querySelector('.wl-count');
        if (!el) return;
        const m = el.textContent.trim().match(/^(\d+)\s*评论$/);
        if (m) el.textContent = `评论 (${m[1]})`;
      }
      new MutationObserver(fixCount).observe(container, {
        childList: true,
        subtree: true,
      });
      fixCount();
    } catch (err) {
      console.error('Waline failed to load:', err);
      container.textContent = '评论系统加载失败，请稍后刷新重试';
    }
  })();
    </script>
  </>
)}

{COMMENT_CONFIG.enable && COMMENT_CONFIG.provider === 'giscus' && (
  <section class="comment">
    <div class="giscus" data-term={term}></div>

    <script>
      import { COMMENT_CONFIG } from '../config';

      function initGiscus() {
        const container = document.querySelector<HTMLElement>('.giscus');
        if (!container) return;

        const config = COMMENT_CONFIG.giscus;

        const themeUrl = (file: string) => {
          const url = new URL(`/${file}`, window.location.origin);
          url.searchParams.set('v', config.themeVersion);
          return url.href;
        };
        const currentTheme = () =>
          document.documentElement.dataset.theme === 'dark'
            ? themeUrl('giscus-dark.css')
            : themeUrl('giscus-light.css');

        const attributes: Record<string, string> = {
          'data-repo': config.repo,
          'data-repo-id': config.repoId,
          'data-category': config.category,
          'data-category-id': config.categoryId,
          'data-mapping': config.mapping,
          'data-term': container.dataset.term ?? window.location.pathname,
          'data-strict': config.strict,
          'data-reactions-enabled': config.reactionsEnabled,
          'data-emit-metadata': config.emitMetadata,
          'data-input-position': config.inputPosition,
          'data-lang': config.lang,
        };

        // 主题切换时通知 giscus 的 iframe 重新加载对应配色
        function updateTheme() {
          const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
          if (!iframe?.contentWindow) return;
          iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: currentTheme() } } },
            'https://giscus.app',
          );
        }

        new MutationObserver(updateTheme).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });

        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.async = true;
        script.crossOrigin = 'anonymous';
        for (const [key, value] of Object.entries(attributes)) {
          script.setAttribute(key, value);
        }
        script.setAttribute('data-theme', currentTheme());
        container.appendChild(script);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGiscus);
      } else {
        initGiscus();
      }
    </script>
  </section>
)}

<style>
  .comment {
    margin-top: 2rem;
  }
</style>
