---
import IndexPage from "@/layouts/IndexPage.astro";
import Friends from "@/components/Friends.astro";
import {friendshipLinks, site} from "@/consts";

const myAvatar = site.url.replace(/\/$/, '') + site.avatar;
---

<IndexPage frontmatter={{ comment: true }}>
  <section class="mb-6 border border-neutral-200 bg-white rounded-sm shadow-sm p-6 dark:border-neutral-800 dark:bg-neutral-900">
    <h1 class="text-xl font-bold tracking-wide text-neutral-900 dark:text-neutral-100">友情链接</h1>
    <p class="mt-3 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
      欢迎交换友链。请先把本站加入你的友链列表，再在下方评论区留言并附上你的站点信息，我看到后会尽快添加。
    </p>

    <h2 class="mt-5 text-sm font-bold tracking-wide text-neutral-900 dark:text-neutral-100">友链格式</h2>
    <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm text-neutral-600 dark:text-neutral-400">
      <li>
        <code class="rounded-sm bg-neutral-100 px-1.5 py-0.5 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">name</code>
        <span class="ml-1">站点名称</span>
      </li>
      <li>
        <code class="rounded-sm bg-neutral-100 px-1.5 py-0.5 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">url</code>
        <span class="ml-1">站点链接</span>
      </li>
      <li>
        <code class="rounded-sm bg-neutral-100 px-1.5 py-0.5 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">avatar</code>
        <span class="ml-1">头像链接（建议正方形）</span>
      </li>
      <li>
        <code class="rounded-sm bg-neutral-100 px-1.5 py-0.5 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">description</code>
        <span class="ml-1">一句话简介</span>
      </li>
    </ul>

    <h2 class="mt-5 text-sm font-bold tracking-wide text-neutral-900 dark:text-neutral-100">本站信息（示例）</h2>
    <pre class="mt-3 overflow-auto border border-neutral-200 bg-neutral-50 p-4 text-xs leading-6 text-neutral-700 rounded-sm dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-300"><code>{`name: ${site.title}
url: ${site.url}
avatar: ${myAvatar}
description: ${site.motto}`}</code></pre>
  </section>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
    {friendshipLinks ? friendshipLinks.map((friend) => <Friends {...friend} />) : ""}
  </div>
</IndexPage>
